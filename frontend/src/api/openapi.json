  "components": {
    "schemas": {
      "CancelResponse": {
        "properties": {
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "scan_id",
          "cancelled",
          "status"
        ],
        "title": "CancelResponse"
      },
      "FindingsListResponse": {
        "properties": {
          "findings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Findings"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "findings",
          "total"
        ],
        "title": "FindingsListResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdentityConfig": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Unique persona name (e.g. userA, admin)"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Default role if not specified in JWT claims",
            "default": "user"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Login username or identifier"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password",
            "description": "Login password strictly protected as SecretStr",
            "writeOnly": true
          },
          "login_path": {
            "type": "string",
            "title": "Login Path",
            "description": "Authentication endpoint path",
            "default": "/auth/login"
          },
          "token_key": {
            "type": "string",
            "title": "Token Key",
            "description": "JSON response key containing token",
            "default": "access_token"
          },
          "username_field": {
            "type": "string",
            "title": "Username Field",
            "description": "Form field or JSON key for username",
            "default": "username"
          },
          "password_field": {
            "type": "string",
            "title": "Password Field",
            "description": "Form field or JSON key for password",
            "default": "password"
          }
        },
        "type": "object",
        "required": [
          "name",
          "username",
          "password"
        ],
        "title": "IdentityConfig",
        "description": "Configuration specification for a test identity persona."
      },
      "MatrixResponse": {
        "properties": {
          "identities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Identities"
          },
          "cells": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Cells"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "identities",
          "cells",
          "summary"
        ],
        "title": "MatrixResponse"
      },
      "NotesResponse": {
        "properties": {
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "notes",
          "total"
        ],
        "title": "NotesResponse"
      },
      "ScanConfig": {
        "properties": {
          "spec_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Url",
            "description": "URL to remote OpenAPI specification"
          },
          "spec_inline": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spec Inline",
            "description": "Inline OpenAPI specification dictionary"
          },
          "base_url": {
            "type": "string",
