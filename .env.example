# SentinelAPI Security Scanner Configuration
ALLOWED_HOSTS=["localhost","127.0.0.1","target_api"]
REQUEST_TIMEOUT=10.0
MAX_RPS=20
RATE_LIMIT_PROBE_COUNT=40
MAX_REQUESTS_PER_SCAN=1000
MAX_RESPONSE_BYTES=2000000
DISCOVERY_MAX_REQUESTS_PER_IDENTITY=30
TEST_CASE_BUDGET=150
MIN_REPORT_CONFIDENCE=0.5
CASE_CONCURRENCY=5
CHECK_TIMEOUT_SECONDS=120
DATA_DIR=data
MAX_CONCURRENT_SCANS=2
MAX_STORED_SCANS=50
SCAN_TIMEOUT_SECONDS=900
# Set SENTINEL_API_KEY to require X-API-Key on all /scans endpoints
SENTINEL_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
MAX_SPEC_BYTES=10000000
MAX_IDENTITIES=5
MAX_TEST_CASE_BUDGET=500

# ── AI Analyst (Phase 10) ───────────────────────────────────────────────────
# AI_ENABLED=false means the product runs exactly as Phases 1-9 with no LLM calls.
# Set to true only when you have also set LLM_API_KEY below.
AI_ENABLED=false

# Provider: groq | openrouter | gemini
LLM_PROVIDER=groq

# Paste your provider API key here. This value MUST NOT be committed to git.
# .env is already in .gitignore; never use this file (.env.example) for a real key.
LLM_API_KEY=

# Model to use. Leave blank to use the provider's recommended fast model:
#   groq:        llama-3.1-8b-instant
#   openrouter:  meta-llama/llama-3.1-8b-instruct:free
#   gemini:      gemini-2.0-flash
LLM_MODEL=

# Timeout in seconds for a single LLM call
AI_TIMEOUT_SECONDS=30

# Maximum LLM API calls charged per scan (cache hits are free)
AI_MAX_CALLS_PER_SCAN=15

# Maximum tokens the model may generate per call
AI_MAX_OUTPUT_TOKENS=900

# Maximum simultaneous in-flight LLM requests
AI_CONCURRENCY=2
