{
  "openapi": "3.1.0",
  "info": {
    "title": "Target API (Vulnerable Demo)",
    "description": "Intentionally vulnerable sandbox API serving as a verification target for the SentinelAPI security scanner. Switch between vulnerable (SECURE=false) and hardened (SECURE=true) modes via environment variable.",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User Login",
        "description": "Authenticate with username and password to obtain a bearer JWT token.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get Current User Profile",
        "description": "Retrieve the authenticated caller's own safe user profile details.",
        "operationId": "get_current_user",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMe"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get User By ID",
        "description": "Retrieve public profile of a user by numeric user identifier.",
        "operationId": "get_user_by_id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List Current User's Orders",
        "description": "Retrieve all purchase orders placed by the authenticated user.",
        "operationId": "list_orders",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrderResponse"
                  },
                  "type": "array",
                  "title": "Response List Orders"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create New Order",
        "description": "Place a new purchase order for the authenticated caller.",
        "operationId": "create_order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get Order By ID",
        "description": "Retrieve details of a specific purchase order by ID.",
        "operationId": "get_order_by_id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Orders"
        ],
        "summary": "Update Order By ID",
        "description": "Update address or status of an existing order.",
        "operationId": "update_order",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Orders"
        ],
        "summary": "Delete Order By ID",
        "description": "Cancel and delete an order record.",
        "operationId": "delete_order",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List All Users (Admin)",
        "description": "Administrative endpoint retrieving complete internal user records.",
        "operationId": "admin_list_users",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserFull"
                  },
                  "type": "array",
                  "title": "Response Admin List Users"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/reports/summary": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Executive Summary Report",
        "description": "Calculates cumulative financial totals, active order volume, and registered user counts.",
        "operationId": "get_reports_summary",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportSummaryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "List Catalog Products",
        "description": "Retrieve list of all catalog products available for purchase.",
        "operationId": "list_products",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductResponse"
                  },
                  "type": "array",
                  "title": "Response List Products"
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Get Product By ID",
        "description": "Retrieve single product details by identifier.",
        "operationId": "get_product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Reports service operational status.",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/_reset": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Reset Seed Data (Demo / Test Helper Only)",
        "description": "Resets all in-memory database records to original seed state and clears rate limits.",
        "operationId": "reset_state",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items",
            "description": "Ordered product items"
          },
          "shipping_address": {
            "type": "string",
            "title": "Shipping Address",
            "description": "Physical destination address"
          }
        },
        "type": "object",
        "required": [
          "items",
          "shipping_address"
        ],
        "title": "CreateOrderRequest",
        "description": "Payload to create a new customer purchase order."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operational status flag",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Service status health check response."
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "description": "User account username",
            "examples": [
              "userA"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Account secret password",
            "examples": [
              "passA123"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "description": "User credentials for authentication."
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "Signed JSON Web Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "Token authorization type",
            "default": "bearer"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id",
            "description": "Authenticated user identifier"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User permission role"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user_id",
          "role"
        ],
        "title": "LoginResponse",
        "description": "JWT bearer token and authenticated user metadata."
      },
      "OrderItem": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id",
            "description": "Catalog product identifier"
          },
          "qty": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Qty",
            "description": "Quantity of product ordered"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "qty"
        ],
        "title": "OrderItem",
        "description": "Single line item within a purchase order."
      },
      "OrderResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Order unique identifier"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id",
            "description": "Owner customer identifier"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "title": "Items",
            "description": "Ordered items list"
          },
          "total": {
            "type": "number",
            "title": "Total",
            "description": "Calculated monetary total"
          },
          "shipping_address": {
            "type": "string",
            "title": "Shipping Address",
            "description": "Physical destination address"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Lifecycle order status, e.g. pending, shipped"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "items",
          "total",
          "shipping_address",
          "status"
        ],
        "title": "OrderResponse",
        "description": "Detailed purchase order response representation."
      },
      "ProductResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Product unique identifier"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Display title of product"
          },
          "price": {
            "type": "number",
            "title": "Price",
            "description": "Unit price of product"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "price"
        ],
        "title": "ProductResponse",
        "description": "Catalog product item response."
      },
      "ReportSummaryResponse": {
        "properties": {
          "total_orders": {
            "type": "integer",
            "title": "Total Orders",
            "description": "Total count of orders created"
          },
          "total_revenue": {
            "type": "number",
            "title": "Total Revenue",
            "description": "Sum total of revenue generated"
          },
          "total_users": {
            "type": "integer",
            "title": "Total Users",
            "description": "Count of registered users"
          }
        },
        "type": "object",
        "required": [
          "total_orders",
          "total_revenue",
          "total_users"
        ],
        "title": "ReportSummaryResponse",
        "description": "High-level executive financial and usage metrics."
      },
      "ResetResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Reset status confirmation",
            "default": "reset"
          }
        },
        "type": "object",
        "title": "ResetResponse",
        "description": "Result of state reset invocation."
      },
      "UpdateOrderRequest": {
        "properties": {
          "shipping_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shipping Address",
            "description": "Updated destination address"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "Updated lifecycle status"
          }
        },
        "type": "object",
        "title": "UpdateOrderRequest",
        "description": "Payload to modify existing order metadata."
      },
      "UserFull": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "User unique identifier"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Account login username"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Plaintext demo password"
          },
          "password_hash": {
            "type": "string",
            "title": "Password Hash",
            "description": "Password hash digest"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name",
            "description": "User full legal name"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Contact email address"
          },
          "ssn": {
            "type": "string",
            "title": "Ssn",
            "description": "Government Social Security Number"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User authorization role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "password",
          "password_hash",
          "full_name",
          "email",
          "ssn",
          "role"
        ],
        "title": "UserFull",
        "description": "Full internal user record leaking sensitive identifiers."
      },
      "UserMe": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "User unique identifier"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Account login username"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name",
            "description": "User full legal name"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Contact email address"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User authorization role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "full_name",
          "email",
          "role"
        ],
        "title": "UserMe",
        "description": "Safe authenticated profile for current caller."
      },
      "UserPublic": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "User unique identifier"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name",
            "description": "User full legal name"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Contact email address"
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "email"
        ],
        "title": "UserPublic",
        "description": "Safe public user profile schema."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}